# ============================================================
# Biến môi trường của agent. Dùng: cp .env.example .env rồi điền giá trị.
# File .env nằm trong .gitignore — KHÔNG commit secret thật.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Số worker uvicorn trong Docker (mặc định 2)
WEB_CONCURRENCY=2

# Security — bắt buộc. Tạo key ngẫu nhiên, vd: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis — docker compose tự đặt redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard: ngân sách LLM mỗi ngày (USD) cho mỗi API key
DAILY_BUDGET_USD=1.0
